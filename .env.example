# Local development: leave keys empty to allow loopback requests only.
# Public deployment: set TWO different, independently generated random keys.
# Generate each key separately: python -c 'import secrets; print(secrets.token_urlsafe(32))'
AIRP_ADMIN_KEY=
AIRP_READ_KEY=

# Keep the database on persistent storage in deployed environments.
AIRP_DB_PATH=data/airp.sqlite3

# Leave empty for local mode. Set the actual public HTTPS origin for Actions.
# Setting a public URL requires both independent keys above.
AIRP_PUBLIC_URL=
